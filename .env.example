NODE_ENV=production
PORT=3000
MONGO_URI=
JWT_SECRET=
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
FRONTEND_URL=https://www.baylink.us
# Optional: comma-separated exact HTTPS origins; never use a wildcard.
CORS_ALLOWED_ORIGINS=
# Render's one-edge-hop contract. Set 0 when serving directly. Never trust all.
# If an additional trusted ingress is used, configure exact CIDRs instead;
# the origin must not admit a shorter untrusted path with spoofed headers.
TRUST_PROXY_HOPS=1
# Warning: a nonempty list REPLACES the hop count above. If it misses Render's
# own hop, every visitor collapses into ONE rate-limit and AI-quota key.
# Never set it without the client-IP diagnostic (docs/client-ip-rollout.md).
TRUSTED_PROXY_CIDRS=
# Counting key for rate limits and the guest AI quota. Empty keeps req.ip from
# the hop contract above. "cloudflare" uses CF-Connecting-IP (or else the XFF
# entry Cloudflare appended) only when that trusted hop is a published
# Cloudflare address; IPv6 visitors are keyed per /64. Any other value stops
# startup. Follow docs/client-ip-rollout.md before setting it.
CLIENT_IP_SOURCE=
# Optional replacement for the built-in, dated Cloudflare range list
# (comma-separated CIDRs; an invalid entry stops startup).
CLOUDFLARE_IP_CIDRS=
# Optional ISO UTC end of a client-IP diagnostic window, e.g. 2026-10-08T18:00:00Z:
# [client-ip-diag] log lines with /24 or /48 prefixes only, and
# GET /api/_diag/client-ip. Ignored when in the past or more than 2h after the
# process starts. Delete it after use.
CLIENT_IP_DIAGNOSTIC_UNTIL=
# Pacific-day paid AI request reservations shared atomically across instances.
# Local deterministic help/cache hits do not consume a reservation. 0 disables
# new paid work. Each request is also bounded to 8 provider invocations.
AI_DAILY_REQUEST_LIMIT=1000
AI_GUEST_DAILY_LIMIT=15
AI_USER_DAILY_LIMIT=40
AI_CONCURRENCY_LIMIT=6
# Optional providers: missing SMS config returns HTTP 503 rather than simulated success.
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_PHONE_NUMBER=
# Separate, optional provider booking notifications; never reuse OTP consent/from-number.
# Enable only after a Twilio Messaging Service's STOP/opt-out suppression is configured
# and tested. Providers must also opt in separately using their verified phone.
SERVICE_BOOKING_SMS_ENABLED=false
SERVICE_BOOKING_SMS_OPT_OUT_CONFIGURED=false
TWILIO_MESSAGING_SERVICE_SID=
RESEND_API_KEY=
RESEND_FROM_EMAIL=
OPENAI_API_KEY=
OPENAI_MODEL=
# BayBay provider for unified chat, legacy guide chat and shared web research.
# OpenAI remains the default until the Claude server settings are supplied.
BAYBAY_AI_PROVIDER=openai
ANTHROPIC_API_KEY=
# Required for organization-scoped personal/service-account API keys.
ANTHROPIC_WORKSPACE_ID=
ANTHROPIC_BAYBAY_MODEL=claude-opus-5-5
ANTHROPIC_BAYBAY_EFFORT=medium
# Optional per-route overrides (docs/ai-models.md). Unset = the two values above.
# <ROUTE>: AGENT, WEB, FAST, PROFESSIONAL, LEGACY, TRIAGE, HELPER_TRANSLATE, HELPER_PLANNER, ...
# BAYBAY_MODEL_AGENT=claude-haiku-5-5        # claude-opus-5-5 | claude-sonnet-5-5 | claude-haiku-5-5
# BAYBAY_MODEL_HELPERS=claude-haiku-5-5      # every helper_* route
# BAYBAY_EFFORT_AGENT=low                    # low | medium | high
# BAYBAY_MAX_TOKENS_AGENT=                   # Haiku is always >= 4000
# BAYBAY_FIRST_BYTE_MS_AGENT=
# BAYBAY_TOTAL_MS_AGENT=
# BAYBAY_FALLBACKS=default                   # server-side refusal fallback, Opus/Sonnet only; off by default
# BAYBAY_THINKING_FAST=disabled              # Haiku 5.5 only (eval arm); unset = adaptive
# Reported by aiGovernance.getSpendState(); not enforced yet.
# AI_SPEND_SOFT_DAILY_USD=6
# AI_SPEND_HARD_DAILY_USD=10
# Optional ISO UTC deadline for temporary promotional-credit use. An expired
# or malformed nonempty value stops new Claude calls; it never switches to OpenAI.
ANTHROPIC_USE_UNTIL=
# Unified BayBay research/planning (Responses API); preferred model is probed on use.
# Unavailable preferred models fall back explicitly; actual model appears in response metadata.
# These OpenAI model/fallback settings apply only when BAYBAY_AI_PROVIDER=openai.
OPENAI_BAYBAY_MODEL=gpt-6.1-sol
OPENAI_BAYBAY_FALLBACK_MODEL=gpt-4.1-mini
BAYBAY_AGENT_ENABLED=true
# Server-only task-memory signing key; generate at least 32 random bytes.
# Separate from login JWT_SECRET. If unset/too short, JWT_SECRET is used only
# when at least 16 characters long; otherwise signed task memory is disabled.
BAYBAY_STATE_SECRET=
# Shared daily model-run quota. Four research/answer rounds, one final-only recovery, eight model-requested tools.
BAYBAY_DAILY_RUN_LIMIT=200
BAYBAY_MAX_MODEL_ROUNDS=4
# Optional planner override; otherwise the existing OPENAI_MODEL is used.
OPENAI_PLANNER_MODEL=
# Public web lookup shared by BayBay Smart/Web modes and the planner.
# Reuse OPENAI_API_KEY, never OPENAI_MODEL, for the web-search model.
# Defaults to the Responses/web_search-compatible gpt-4.1-mini.
OPENAI_WEB_SEARCH_MODEL=gpt-4.1-mini
# Optional text-only extraction after search; falls back to OPENAI_MODEL, then gpt-4o-mini.
OPENAI_WEB_EXTRACT_MODEL=gpt-4o-mini
OPENAI_WEB_SEARCH_ENABLED=true
# Maximum web tool calls per uncached lookup: 1 or 2 (default and hard cap: 2).
OPENAI_WEB_SEARCH_MAX_TOOL_CALLS=2
# Shared UTC-day tool-call budget across instances; 0 disables new searches.
# Each uncached lookup reserves the maximum above, including failures; no refund
# for fewer actual tool calls. At the defaults, 100 units allow 50 new lookups.
PLANNER_WEB_SEARCH_DAILY_LIMIT=100
# Bounded per-process result cache, maximum 3600 seconds. Query text is not logged.
PLANNER_WEB_SEARCH_CACHE_TTL_SECONDS=600
# Optional on-demand route estimates. Off unless explicitly enabled with a key.
# Keep the Google Routes key on the API server; never expose it as VITE_*.
PLANNER_TRAVEL_ENABLED=false
GOOGLE_ROUTES_API_KEY=
# Shared UTC-day route-request quota across instances; 0 disables estimates.
PLANNER_TRAVEL_DAILY_LIMIT=100
# Optional public-post translation model; defaults to OPENAI_MODEL, then gpt-4o-mini.
OPENAI_TRANSLATION_MODEL=
# New provider calls only. Cached translations do not use this UTC-day budget.
POST_TRANSLATION_DAILY_LIMIT=300
POST_TRANSLATION_CONCURRENCY=3
# Set false to disable scheduled source checks (admin manual checks remain available).
SOURCE_MONITOR_ENABLED=true
# Must stay false in production. Even true is ignored in production.
AUTH_DEV_RETURN_TOKENS=false
