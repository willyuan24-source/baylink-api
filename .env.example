NODE_ENV=production
PORT=3000
MONGO_URI=
JWT_SECRET=
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
FRONTEND_URL=https://www.baylink.us
# Optional: comma-separated exact HTTPS origins; never use a wildcard.
CORS_ALLOWED_ORIGINS=
# Optional providers: missing SMS config returns HTTP 503 rather than simulated success.
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_PHONE_NUMBER=
# Separate, optional provider booking notifications; never reuse OTP consent/from-number.
# Enable only after a Twilio Messaging Service's STOP/opt-out suppression is configured
# and tested. Providers must also opt in separately using their verified phone.
SERVICE_BOOKING_SMS_ENABLED=false
SERVICE_BOOKING_SMS_OPT_OUT_CONFIGURED=false
TWILIO_MESSAGING_SERVICE_SID=
RESEND_API_KEY=
RESEND_FROM_EMAIL=
OPENAI_API_KEY=
OPENAI_MODEL=
# Optional planner override; otherwise the existing OPENAI_MODEL is used.
OPENAI_PLANNER_MODEL=
# Public web lookup shared by BayBay Smart/Web modes and the planner.
# Reuse OPENAI_API_KEY, never OPENAI_MODEL, for the web-search model.
# Defaults to the Responses/web_search-compatible gpt-4.1-mini.
OPENAI_WEB_SEARCH_MODEL=gpt-4.1-mini
# Optional text-only extraction after search; falls back to OPENAI_MODEL, then gpt-4o-mini.
OPENAI_WEB_EXTRACT_MODEL=gpt-4o-mini
OPENAI_WEB_SEARCH_ENABLED=true
# Maximum web tool calls per uncached lookup: 1 or 2 (default and hard cap: 2).
OPENAI_WEB_SEARCH_MAX_TOOL_CALLS=2
# Shared UTC-day tool-call budget across instances; 0 disables new searches.
# Each uncached lookup reserves the maximum above, including failures; no refund
# for fewer actual tool calls. At the defaults, 100 units allow 50 new lookups.
PLANNER_WEB_SEARCH_DAILY_LIMIT=100
# Bounded per-process result cache, maximum 3600 seconds. Query text is not logged.
PLANNER_WEB_SEARCH_CACHE_TTL_SECONDS=600
# Optional on-demand route estimates. Off unless explicitly enabled with a key.
# Keep the Google Routes key on the API server; never expose it as VITE_*.
PLANNER_TRAVEL_ENABLED=false
GOOGLE_ROUTES_API_KEY=
# Shared UTC-day route-request quota across instances; 0 disables estimates.
PLANNER_TRAVEL_DAILY_LIMIT=100
# Optional public-post translation model; defaults to OPENAI_MODEL, then gpt-4o-mini.
OPENAI_TRANSLATION_MODEL=
# New provider calls only. Cached translations do not use this UTC-day budget.
POST_TRANSLATION_DAILY_LIMIT=300
POST_TRANSLATION_CONCURRENCY=3
# Set false to disable scheduled source checks (admin manual checks remain available).
SOURCE_MONITOR_ENABLED=true
# Must stay false in production. Even true is ignored in production.
AUTH_DEV_RETURN_TOKENS=false
